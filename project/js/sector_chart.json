{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 450,
  "height": 250,
  "title": {
    "text": "Australian Drama Expenditure by Sector",
    "subtitle": "Analysis of production spend across distribution platforms (Unit: $M)",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start",
    "offset": 15
  },
  "data": {
    "url": "https://raw.githubusercontent.com/ash415721/DV2/refs/heads/main/drama_sector_breakdown.csv"
  },
  "encoding": {
    "x": {
      "field": "Spend_Millions",
      "type": "quantitative",
      "title": "Expenditure (Millions AUD)",
      "axis": {
        "grid": true,
        "tickCount": 5,
        "labelFontSize": 11
      }
    },
    "y": {
      "field": "Sector",
      "type": "nominal",
      "title": null,
      "sort": "-x",
      "axis": {
        "labelFontSize": 12
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4,
        "height": 24,
        "color": "#34495e"
      },
      "encoding": {
        "tooltip": [
          {"field": "Sector", "type": "nominal", "title": "Sector"},
          {"field": "Spend_Millions", "type": "quantitative", "title": "Spend ($M)"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "Spend_Millions",
          "type": "quantitative",
          "format": "$,"
        }
      }
    }
  ]
}