{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 350,
  "height": 300,
  "title": {
    "text": "The Billion Dollar Divide",
    "subtitle": "Foreign vs. Domestic Spend in Australia (Billions AUD)",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "middle",
    "offset": 20
  },
  "data": {
    "url": "https://raw.githubusercontent.com/ash415721/DV2/refs/heads/main/funding_source.csv"
  },
  "encoding": {
    "theta": {
      "field": "Spend_Billions", 
      "type": "quantitative", 
      "stack": true
    },
    "color": {
      "field": "Category",
      "type": "nominal",
      "scale": {
        "domain": ["International Production", "Australian Titles"],
        "range": ["#e74c3c", "#3498db"]
      },
      "legend": {
        "title": "Funding Source",
        "orient": "bottom",
        "labelFontSize": 12,
        "titleFontSize": 13
      }
    },
    "tooltip": [
      {"field": "Category", "type": "nominal", "title": "Source"},
      {"field": "Spend_Billions", "type": "quantitative", "title": "Spend ($B)"}
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "arc", 
        "innerRadius": 70, 
        "outerRadius": 120, 
        "stroke": "#ffffff", 
        "strokeWidth": 2
      }
    },
    {
      "mark": {
        "type": "text", 
        "radius": 140, 
        "fontSize": 14, 
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "Spend_Billions", 
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "field": "Category"
        }
      }
    }
  ]
}