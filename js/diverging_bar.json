{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 450,
  "height": 200,
  "title": {
    "text": "The Streaming Wars: Local vs. Foreign Investment",
    "subtitle": "Expenditure by major SVOD platforms in Australia ($M)",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start",
    "offset": 15
  },
  "data": {
    "url": "https://raw.githubusercontent.com/ash415721/DV2/refs/heads/main/streaming_investment.csv"
  },
  "transform": [
    {
      "calculate": "datum.Category === 'Foreign' ? -datum.Spend_Millions : datum.Spend_Millions",
      "as": "Signed_Spend"
    }
  ],
  "mark": {"type": "bar", "cornerRadiusEnd": 3},
  "encoding": {
    "y": {
      "field": "Platform",
      "type": "nominal",
      "title": null,
      "axis": {"labelFontSize": 12, "domain": false, "ticks": false}
    },
    "x": {
      "field": "Signed_Spend",
      "type": "quantitative",
      "title": "Expenditure (Negative = Foreign, Positive = Local)",
      "axis": {"format": "s", "grid": true, "labelFontSize": 11}
    },
    "color": {
      "field": "Category",
      "type": "nominal",
      "scale": {
        "domain": ["Foreign", "Local"],
        "range": ["#f39c12", "#2980b9"] 
      },
      "legend": {"title": "Content Origin", "orient": "bottom"}
    },
    "tooltip": [
      {"field": "Platform", "type": "nominal", "title": "Streaming Platform"},
      {"field": "Category", "type": "nominal", "title": "Origin"},
      {"field": "Spend_Millions", "type": "quantitative", "title": "Spend ($M)", "format": "$,"}
    ]
  },
  "config": {
    "view": {"stroke": "transparent"}
  }
}