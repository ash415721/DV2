{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 450,
  "height": 150,
  "title": {
    "text": "Cost Architecture by Studio Size",
    "subtitle": "100% Normalized resource allocation across industry tiers",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start",
    "offset": 15
  },
  "data": {
    "url": "https://raw.githubusercontent.com/ash415721/DV2/refs/heads/main/studio_costs.csv"
  },
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "Percentage",
      "type": "quantitative",
      "title": "Percentage of Total Operating Cost",
      "stack": "normalize",
      "axis": {"format": ".0%", "labelFontSize": 11}
    },
    "y": {
      "field": "Studio_Tier",
      "type": "nominal",
      "title": null,
      "axis": {"labelFontSize": 12}
    },
    "color": {
      "field": "Cost_Component",
      "type": "nominal",
      "scale": {"scheme": "viridis"},
      "legend": {"title": "Expense Category", "orient": "bottom", "columns": 2}
    },
    "tooltip": [
      {"field": "Studio_Tier", "type": "nominal", "title": "Tier"},
      {"field": "Cost_Component", "type": "nominal", "title": "Expense Type"},
      {"field": "Percentage", "type": "quantitative", "title": "Share of Cost"}
    ]
  }
}