{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 450,
  "title": {
    "text": "Geographic Distribution of Australian Post-Production Industry (2021-22)",
    "subtitle": "Visualizing industry scale and studio concentration across states (Based on ABS Data)",
    "fontSize": 16,
    "font": "Arial"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
    "format": {"type": "json", "property": "features"}
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/ash415721/DV2/refs/heads/main/pdv_states.csv"
        },
        "key": "State",
        "fields": ["Value", "Year"]
      }
    },
    {
      "filter": "datum.Year == '2021-22' || datum.Year == null"
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 1.5
  },
  "encoding": {
    "color": {
      "field": "Value",
      "type": "quantitative",
      "scale": {
        "type": "sqrt",
        "scheme": "yellowgreenblue"
      },
      "title": "Industry Value ($M)"
    },
    "tooltip": [
      {"field": "properties.STATE_NAME", "type": "nominal", "title": "State"},
      {"field": "Value", "type": "quantitative", "title": "Value ($M)"}
    ]
  }
}